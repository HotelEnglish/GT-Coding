# Database Configuration
DATABASE_URL="postgresql://postgres:password@localhost:5432/gt_coding?schema=public"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Email Configuration (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# Application Configuration
PORT=3001
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:5173"

# WeChat Payment QR Codes
# Basic Plan: 5 CNY for 5000 characters (500 credits)
WECHAT_QR_BASIC="https://example.com/qr/basic.png"
# Standard Plan: 10 CNY for 12000 characters (1200 credits)
WECHAT_QR_STANDARD="https://example.com/qr/standard.png"
# Premium Plan: 50 CNY for 70000 characters (7000 credits)
WECHAT_QR_PREMIUM="https://example.com/qr/premium.png"

# Database: required when the workbench API is started.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gt_coding?schema=public"

# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"

# Functional-MVP AI provider. The default never sends source data off-device.
AI_PROVIDER=development

# Legacy mock coding endpoints are disabled by default; they return 410 Gone.
# Enable ONLY for local inspection of the frozen legacy flow.
# LEGACY_CODING_ENABLED=true
# AI_TIMEOUT_MS=120000

# Required only when AI_PROVIDER=openai-compatible. Keep real values in server/.env.
# AI_API_BASE_URL="https://api.example.com"
# AI_API_KEY="replace-me"
# AI_MODEL="replace-me"

# ── Frozen modules (auth/checkin/recharge/admin, deferred; see docs/adr/0004 & 0005) ──
# Needed only when legacy auth APIs are exercised in development.
# JWT_SECRET="your-super-secret-jwt-key-change-in-production"
# JWT_EXPIRES_IN="7d"
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER="no-reply@example.com"
# SMTP_PASS="replace-me"

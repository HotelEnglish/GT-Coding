// Prisma Schema for GT-Coding User System and Credit Membership

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// USER MODELS
// ==========================================

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  status       UserStatus @default(active)
  registeredAt DateTime   @default(now())
  lastLoginAt  DateTime?

  // Relations
  creditBalance      CreditBalance?
  checkIns           CheckIn[]
  creditTransactions CreditTransaction[]
  rechargeOrders     RechargeOrder[]
  codingTasks        CodingTask[]
  sessions           Session[]

  @@index([email])
  @@map("users")
}

enum UserStatus {
  active
  disabled
}

model AdminUser {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  createdAt    DateTime @default(now())
  lastLoginAt  DateTime?

  // Relations
  sessions           AdminSession[]
  actionLogs         AdminActionLog[]
  processedOrders    RechargeOrder[]
  creditAdjustments  CreditTransaction[]

  @@map("admin_users")
}

// ==========================================
// SESSION MODELS
// ==========================================

model Session {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash      String   @unique
  createdAt      DateTime @default(now())
  expiresAt      DateTime
  lastAccessedAt DateTime @default(now())

  @@index([tokenHash])
  @@index([userId])
  @@map("sessions")
}

model AdminSession {
  id             String     @id @default(cuid())
  adminId        String
  admin          AdminUser  @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash      String     @unique
  createdAt      DateTime   @default(now())
  expiresAt      DateTime
  lastAccessedAt DateTime   @default(now())

  @@index([tokenHash])
  @@map("admin_sessions")
}

// ==========================================
// CREDIT MODELS
// ==========================================

model CreditBalance {
  id      String @id @default(cuid())
  userId  String @unique
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance Int    @default(0) // in credits

  @@map("credit_balances")
}

model CreditTransaction {
  id                String          @id @default(cuid())
  transactionNumber String          @unique
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  // For admin adjustments, track which admin made the change
  adminId  String?
  admin    AdminUser?    @relation(fields: [adminId], references: [id])

  type        TransactionType
  amount      Int    // positive for income, negative for expense
  balanceAfter Int   // balance after this transaction
  description String
  relatedId   String? // ID of related entity (orderId, codingTaskId, etc.)
  createdAt   DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([type])
  @@map("credit_transactions")
}

enum TransactionType {
  registration_bonus // 注册赠送
  check_in // 签到奖励
  check_in_bonus // 连续签到奖励
  recharge // 充值
  coding_consumption // 编码消耗
  admin_adjustment // 管理员调整
}

// ==========================================
// CHECK-IN MODELS
// ==========================================

model CheckIn {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkedInAt    DateTime @default(now())
  creditsAwarded Int
  bonusAwarded   Int      @default(0)
  consecutiveDays Int     @default(1)

  // Store the date in China timezone for querying
  checkInDate String // Format: YYYY-MM-DD in UTC+8

  @@unique([userId, checkInDate])
  @@index([userId, checkedInAt(sort: Desc)])
  @@map("check_ins")
}

// ==========================================
// RECHARGE MODELS
// ==========================================

model RechargePlan {
  id         String  @id
  name       String
  price      Int // in CNY (yuan)
  credits    Int
  characters Int
  qrCodeUrl  String
  isActive   Boolean @default(true)
  createdAt  DateTime @default(now())

  @@map("recharge_plans")
}

model RechargeOrder {
  id               String      @id @default(cuid())
  orderNumber      String      @unique
  userId           String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  planId           String
  credits          Int // credits to be awarded

  paymentTime      DateTime
  transactionLast4 String // last 4 digits of transaction ID

  status OrderStatus @default(pending)

  // Admin processing
  processedById    String?
  processedBy      AdminUser?  @relation(fields: [processedById], references: [id])
  processedAt      DateTime?
  rejectionReason  String?

  submittedAt DateTime @default(now())

  @@index([userId])
  @@index([status])
  @@index([submittedAt(sort: Desc)])
  @@map("recharge_orders")
}

enum OrderStatus {
  pending
  approved
  rejected
}

// ==========================================
// CODING TASK MODEL
// ==========================================

model CodingTask {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  inputTextLength Int // character count
  creditsConsumed Int
  theory          String
  depth           String

  // Store reference to result (actual result stored separately or in blob storage)
  resultStored Boolean @default(false)

  completedAt DateTime @default(now())

  @@index([userId, completedAt(sort: Desc)])
  @@map("coding_tasks")
}

// ==========================================
// RESEARCH WORKBENCH MODELS (FUNCTIONAL MVP)
// ==========================================

enum MethodologyProfile {
  procedural
}

enum AnalysisRunStatus {
  queued
  running
  completed
  failed
  cancelled
}

enum ArtifactOrigin {
  ai
  researcher
}

enum ReviewStatus {
  suggested
  accepted
  edited
  rejected
  deferred
}

model ResearchProject {
  id           String             @id @default(cuid())
  workspaceId  String
  title        String
  researchQuestion String?
  methodology  MethodologyProfile @default(procedural)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  documents       SourceDocument[]
  codes           ResearchCode[]
  memos           AnalyticMemo[]
  analysisRuns    AnalysisRun[]
  relationships   CategoryRelationship[]

  @@index([workspaceId, updatedAt(sort: Desc)])
  @@map("research_projects")
}

model SourceDocument {
  id          String          @id @default(cuid())
  projectId   String
  project     ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  createdAt   DateTime        @default(now())

  versions SourceDocumentVersion[]

  @@index([projectId, createdAt(sort: Desc)])
  @@map("source_documents")
}

model SourceDocumentVersion {
  id          String         @id @default(cuid())
  documentId  String
  document    SourceDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version     Int
  content     String         @db.Text
  contentHash String
  createdAt   DateTime       @default(now())

  segments    SourceSegment[]
  analysisRuns AnalysisRun[]

  @@unique([documentId, version])
  @@index([contentHash])
  @@map("source_document_versions")
}

model SourceSegment {
  id                String                @id @default(cuid())
  documentVersionId String
  documentVersion   SourceDocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  startOffset       Int
  endOffset         Int
  text              String                @db.Text
  contentHash       String
  createdAt         DateTime              @default(now())

  assignments CodeAssignment[]

  @@unique([documentVersionId, startOffset, endOffset])
  @@index([documentVersionId, startOffset])
  @@map("source_segments")
}

model ResearchCode {
  id          String          @id @default(cuid())
  projectId   String
  project     ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  label       String
  definition  String?
  origin      ArtifactOrigin
  status      ReviewStatus   @default(suggested)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  assignments        CodeAssignment[]
  sourceRelationships CategoryRelationship[] @relation("RelationshipSourceCode")
  targetRelationships CategoryRelationship[] @relation("RelationshipTargetCode")

  @@unique([projectId, label])
  @@index([projectId, status])
  @@map("research_codes")
}

model CodeAssignment {
  id              String        @id @default(cuid())
  codeId          String
  code            ResearchCode  @relation(fields: [codeId], references: [id], onDelete: Cascade)
  sourceSegmentId String
  sourceSegment   SourceSegment @relation(fields: [sourceSegmentId], references: [id], onDelete: Cascade)
  evidenceQuote   String        @db.Text
  origin          ArtifactOrigin
  status          ReviewStatus  @default(suggested)
  rationale       String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  decisions ResearchDecision[]

  @@index([sourceSegmentId])
  @@index([codeId, status])
  @@map("code_assignments")
}

model AnalyticMemo {
  id        String          @id @default(cuid())
  projectId String
  project   ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  content   String          @db.Text
  origin    ArtifactOrigin
  status    ReviewStatus   @default(suggested)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  decisions ResearchDecision[]

  @@index([projectId, status])
  @@map("analytic_memos")
}

model CategoryRelationship {
  id           String          @id @default(cuid())
  projectId    String
  project      ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceCodeId String
  sourceCode   ResearchCode    @relation("RelationshipSourceCode", fields: [sourceCodeId], references: [id], onDelete: Cascade)
  targetCodeId String
  targetCode   ResearchCode    @relation("RelationshipTargetCode", fields: [targetCodeId], references: [id], onDelete: Cascade)
  relationType String
  rationale    String?         @db.Text
  origin       ArtifactOrigin
  status       ReviewStatus    @default(suggested)
  createdAt    DateTime        @default(now())

  @@index([projectId, status])
  @@map("category_relationships")
}

model AnalysisRun {
  id                String                @id @default(cuid())
  workspaceId       String
  projectId         String
  project           ResearchProject       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  documentVersionId String
  documentVersion   SourceDocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Restrict)
  requestKey        String
  status            AnalysisRunStatus    @default(queued)
  errorMessage      String?
  createdAt         DateTime              @default(now())
  startedAt         DateTime?
  completedAt       DateTime?

  modelRun ModelRun?

  @@unique([workspaceId, requestKey])
  @@index([projectId, createdAt(sort: Desc)])
  @@map("analysis_runs")
}

model ModelRun {
  id              String      @id @default(cuid())
  analysisRunId   String      @unique
  analysisRun     AnalysisRun @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
  provider        String
  model           String
  promptVersion   String
  inputTokens     Int?
  outputTokens    Int?
  latencyMs       Int?
  requestMetadata Json?
  createdAt       DateTime    @default(now())

  @@map("model_runs")
}

model ResearchDecision {
  id               String         @id @default(cuid())
  codeAssignmentId String?
  codeAssignment   CodeAssignment? @relation(fields: [codeAssignmentId], references: [id], onDelete: Cascade)
  memoId           String?
  memo             AnalyticMemo? @relation(fields: [memoId], references: [id], onDelete: Cascade)
  action           ReviewStatus
  rationale        String?        @db.Text
  createdAt        DateTime       @default(now())

  @@index([codeAssignmentId, createdAt])
  @@index([memoId, createdAt])
  @@map("research_decisions")
}

// ==========================================
// VERIFICATION CODE MODEL
// ==========================================

model VerificationCode {
  id        String              @id @default(cuid())
  email     String
  code      String // 6-digit code
  purpose   VerificationPurpose
  createdAt DateTime            @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  @@index([email, purpose])
  @@map("verification_codes")
}

enum VerificationPurpose {
  registration
  password_reset
}

// ==========================================
// ADMIN ACTION LOG
// ==========================================

model AdminActionLog {
  id         String    @id @default(cuid())
  adminId    String
  admin      AdminUser @relation(fields: [adminId], references: [id])
  action     String
  targetType String // 'order', 'user', 'credit'
  targetId   String
  details    Json? // Additional details
  createdAt  DateTime  @default(now())

  @@index([adminId])
  @@index([targetType, targetId])
  @@map("admin_action_logs")
}

// ==========================================
// NOTIFICATION MODEL
// ==========================================

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  content   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

enum NotificationType {
  check_in_success
  check_in_milestone
  recharge_approved
  recharge_rejected
  low_balance_warning
}
